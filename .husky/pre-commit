#!/bin/sh

echo '🏗️👷 Running Biome on staged files before commit'

bun lint-staged ||
  (
    echo '🔨❌ Lint/format errors. Run `bun lint:fix` then re-stage. 🔨❌
     '
    false
  )

echo '🧪👷 Checking every component is paired with a test'

bun run scripts/test-governance.ts --staged ||
  (
    echo '🧪❌ Missing or orphaned tests. Add/remove the mirror test in tests/ then re-stage. 🧪❌
     '
    false
  )

echo '✅ Staged files clean. Committing.'
