{
    "name": "starter-with-lint",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=24"
    },
    "packageManager": "bun@1.3.14",
    "scripts": {
        "dev": "bun run gen:i18n && concurrently -k -n yaml,next -c cyan,magenta \"bun run gen:i18n:watch\" \"next dev\"",
        "build": "bun run gen:i18n && next build",
        "start": "next start",
        "gen:i18n": "bun run scripts/gen-messages.ts",
        "gen:i18n:watch": "bun run scripts/gen-messages.ts --watch",
        "lint": "biome check",
        "lint:fix": "biome check --write",
        "format": "biome format --write && prettier --write \"locales/**/*.{yaml,yml}\"",
        "format:yaml": "prettier --write \"locales/**/*.{yaml,yml}\"",
        "check-format": "biome format && prettier --check \"locales/**/*.{yaml,yml}\"",
        "check-lint": "biome lint",
        "check-types": "bun run gen:i18n && next typegen && tsc --pretty --noEmit",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:governance": "bun run scripts/test-governance.ts --all",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test-all": "bun run check-format && bun run check-lint && bun run check-types && bun run test:governance && bun run test:coverage && bun run build",
        "prepare": "[ -n \"$SKIP_HUSKY\" ] || node .husky/install.mjs",
        "commit": "commitizen"
    },
    "dependencies": {
        "@base-ui/react": "^1.6.0",
        "@hugeicons/core-free-icons": "^4.2.2",
        "@hugeicons/react": "^1.1.9",
        "@radix-ui/react-accordion": "^1.2.16",
        "@radix-ui/react-avatar": "^1.2.2",
        "@radix-ui/react-dialog": "^1.1.19",
        "@radix-ui/react-dropdown-menu": "^2.1.20",
        "@radix-ui/react-icons": "^1.3.2",
        "@radix-ui/react-navigation-menu": "^1.2.18",
        "@radix-ui/react-scroll-area": "^1.2.14",
        "@radix-ui/react-separator": "^1.1.11",
        "@radix-ui/react-slot": "^1.3.0",
        "@radix-ui/react-tooltip": "^1.2.12",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "next": "16.2.10",
        "next-intl": "^4.13.2",
        "next-themes": "^0.4.6",
        "radix-ui": "^1.6.2",
        "react": "19.2.7",
        "react-dom": "19.2.7",
        "shadcn": "^4.13.0",
        "sharp": "^0.35.3",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "uuid": "^14.0.1"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.4",
        "@commitlint/config-conventional": "^21.2.0",
        "@commitlint/format": "^21.2.0",
        "@playwright/test": "^1.61.1",
        "@tailwindcss/postcss": "^4.3.2",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "24.10.1",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "@vitest/coverage-v8": "^4.1.10",
        "autoprefixer": "10.5.3",
        "chokidar": "^5.0.0",
        "commitizen": "^4.3.2",
        "concurrently": "^10.0.3",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "lint-staged": "^17.0.8",
        "match-sorter": "^8.3.0",
        "postcss": "8.5.19",
        "prettier": "^3.9.5",
        "tailwindcss": "4.3.2",
        "tailwindcss-animated": "^2.1.0",
        "typescript": "6.0.3",
        "vitest": "^4.1.10",
        "yaml": "^2.9.0"
    },
    "ignoreScripts": [
        "sharp",
        "unrs-resolver"
    ],
    "trustedDependencies": [
        "sharp",
        "unrs-resolver"
    ]
}
